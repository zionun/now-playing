# Configurazione Server Now Playing
# Copia questo file in .env e modifica i valori secondo la tua configurazione

# Token Plex (obbligatorio, oppure configurabile da /config)
PLEX_TOKEN=

# Server Plex (obbligatorio, oppure configurabile da /config)
PLEX_SERVER_URL=http://192.168.1.100:32400
PLEX_SERVER_PORT=32400

# Player IP (opzionale - verrà scoperto automaticamente)
PLAYER_IP=

# Client URL (per CORS)
CLIENT_URL=http://localhost:3000

# Porta server (default: 3001)
PORT=3001

# Ambiente di sviluppo
NODE_ENV=production