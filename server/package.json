{
  "name": "now-playing-server",
  "version": "0.9.0",
  "type": "module",
  "main": "src/index.js",
  "nodemonConfig": {
    "ignore": [
      "src/config/*.json"
    ]
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
