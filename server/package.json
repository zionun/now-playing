    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.9",
    "vitest": "^2.1.9"
